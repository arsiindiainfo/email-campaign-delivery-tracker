{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3UploadsAccess",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::arsiindiainfo-email-campaign-uploads/*"
        },
        {
            "Sid": "SqsQueueAccess",
            "Effect": "Allow",
            "Action": [
                "sqs:SendMessage",
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:GetQueueAttributes",
                "sqs:GetQueueUrl"
            ],
            "Resource": [
                "arn:aws:sqs:ap-south-2:952151418940:email-campaign-send-queue",
                "arn:aws:sqs:ap-south-2:952151418940:email-campaign-webhook-queue",
                "arn:aws:sqs:ap-south-2:952151418940:email-campaign-import-queue"
            ]
        },
        {
            "Sid": "SesSendAccess",
            "Effect": "Allow",
            "Action": [
                "ses:SendEmail",
                "ses:SendRawEmail"
            ],
            "Resource": "arn:aws:ses:ap-south-2:952151418940:identity/arsiindiainfo.com"
        }
    ]
}
