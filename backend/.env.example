# Copy to .env for local development (docker-compose already injects these for the
# api/worker services — this file is for running `npm run start:dev` on the host).

NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/email-campaign-tracker?replicaSet=rs0

JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:5173

PUBLIC_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5173

# smtp = Mailhog (never a real send); ses = Amazon SES (production only)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack endpoint for SQS/S3/SNS in local dev — leave blank to use real AWS
AWS_ENDPOINT=http://localhost:4566

SES_FROM_VERIFIED_DOMAINS=novamail.demo
# Required in production for bounce/complaint/delivery tracking to work —
# without it, SES sends outside the configuration set and never publishes
# events to the SNS->SQS webhook pipeline. Not used by LocalStack in dev.
SES_CONFIGURATION_SET=
SNS_WEBHOOK_SIGNING_SECRET=demo-webhook-signing-secret

SQS_SEND_QUEUE_URL=http://localhost:4566/000000000000/send-queue
SQS_SEND_QUEUE_DLQ_URL=http://localhost:4566/000000000000/send-queue-dlq
SQS_WEBHOOK_QUEUE_URL=http://localhost:4566/000000000000/webhook-queue
SQS_WEBHOOK_QUEUE_DLQ_URL=http://localhost:4566/000000000000/webhook-queue-dlq
SQS_IMPORT_QUEUE_URL=http://localhost:4566/000000000000/import-queue
SQS_IMPORT_QUEUE_DLQ_URL=http://localhost:4566/000000000000/import-queue-dlq

S3_UPLOADS_BUCKET=email-campaign-tracker-uploads

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Google reCAPTCHA v2 ("I'm not a robot") — gates /auth/register and /auth/login.
# Get a key pair at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
